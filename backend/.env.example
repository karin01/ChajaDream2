# 텔레그램 봇 (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# 기본 알림 채널 (커뮤니티 찾는다/임보 + 실종·발견 폴백용)
TELEGRAM_CHAT_ID=

# 사이트 주소 (알림 링크)
PUBLIC_BASE_URL=http://127.0.0.1:8765

# --- 지역 라우팅 (선택) ---
# telegram_regions.json 에 시·구별 그룹 chat_id 를 적으면, 주소에 키워드가 있을 때 그 채팅으로도 전송됩니다.
# 지역 매칭이 하나도 없을 때 기본 채널로내려면 true (기본값)
TELEGRAM_REGION_FALLBACK_DEFAULT=true
# 지역 매칭이 있어도 항상 TELEGRAM_CHAT_ID 로도내려면 true
TELEGRAM_ALWAYS_SEND_DEFAULT=false

# 로컬에서 poll_telegram_bot.py 를 돌릴 때 기본은 deleteWebhook 호출(옛 웹훅 제거).
# 같은 봇을 이미 서버 웹훅으로 쓰는 중이면 1 로 두어 생략 (로컬 폴링은 그래도 웹훅과 동시 수신은 불가)
# TELEGRAM_POLL_NO_DELETE_WEBHOOK=

# --- 웹훅 (선택, 공인 HTTPS 필요) ---
# 예: 무작위 긴 문자열. URL: https://도메인/api/telegram/webhook/그문자열
TELEGRAM_WEBHOOK_SECRET=

# --- 운영진 모드 (선택) ---
# 커뮤니티 글/답글 삭제 시 게시글 비밀번호 대신 이 값을 staffSecret 으로 보내면 삭제 허용.
# 비우면 운영진 전용 삭제 비활성(일반 비밀번호만).
STAFF_MODE_SECRET=

# 등록 금지어 추가(쉼표로 구분, 2글자 이상만). 예: BANNED_WORDS_EXTRA=단어1,단어2
BANNED_WORDS_EXTRA=
